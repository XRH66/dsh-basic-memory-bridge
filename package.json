    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "basic-memory",
    "memory"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/XRH66/dsh-basic-memory-bridge.git"
  },
  "homepage": "https://github.com/XRH66/dsh-basic-memory-bridge",
  "bugs": {
    "url": "https://github.com/XRH66/dsh-basic-memory-bridge/issues"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-format-catalog": "0.2.1-rc.2",
    "@local/dsh-global-settings": "git+https://github.com/XRH66/dsh-global-settings.git#f5778e8a7ddcf2be5ba83f895db587b384455a78"
  }
